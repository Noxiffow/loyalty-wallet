# ─── Negocio ──────────────────────────────────────────────────────────────────
BUSINESS_NAME=My Business Name
BUSINESS_PHONE=+34 600 000 000
BUSINESS_EMAIL=hello@mybusiness.com
BUSINESS_ADDRESS_URL=https://maps.google.com/?q=My+Address
BUSINESS_ADDRESS_LABEL=My Street 1, City
BUSINESS_INSTAGRAM=mybusiness
BUSINESS_WEBSITE=https://mybusiness.com
BRAND_COLOR=#1a1a2e

# URL pública del servidor (Railway te la da al hacer deploy)
BASE_URL=https://tu-app.up.railway.app

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=cambia-esto-en-produccion
SESSION_SECRET=una-clave-aleatoria-larga

# ─── Google Wallet ────────────────────────────────────────────────────────────
# Google Cloud Console → IAM → Cuentas de servicio → tu cuenta → Claves → JSON
GOOGLE_SERVICE_ACCOUNT_EMAIL=tu-cuenta@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# pay.google.com/business/console (panel tras registrarte como emisor)
GOOGLE_ISSUER_ID=3388000000000000000
GOOGLE_CLASS_ID=tatiana_vip

# ─── Apple Wallet ─────────────────────────────────────────────────────────────
# developer.apple.com → Certificates, IDs & Profiles → Identifiers → Pass Type IDs
APPLE_PASS_TYPE_ID=pass.com.tatianasilvahairbeauty.vip

# developer.apple.com (esquina superior derecha del portal)
APPLE_TEAM_ID=ABCDE12345

# Rutas a los PEM exportados desde Keychain (ver README)
APPLE_CERT_PATH=./certs/certificate.pem
APPLE_KEY_PATH=./certs/key.pem
APPLE_WWDR_PATH=./certs/wwdr.pem

# Solo si pusiste passphrase al exportar la clave
# APPLE_KEY_PASSPHRASE=

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
